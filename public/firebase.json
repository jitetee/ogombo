{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "FIREBASE.md",
      "SETUP.md",
      "database.rules.json",
      "seed/**"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "rewrites": [
      {
        "source": "/blog",
        "destination": "/blog.html"
      },
      {
        "source": "/content",
        "destination": "/content.html"
      },
      {
        "source": "/materials",
        "destination": "/materials.html"
      },
      {
        "source": "/writing",
        "destination": "/writing/index.html"
      },
      {
        "source": "/blog/**",
        "destination": "/read.html"
      },
      {
        "source": "/content/**",
        "destination": "/read.html"
      },
      {
        "source": "/writing/books/**",
        "destination": "/read.html"
      },
      {
        "source": "/materials/item/**",
        "destination": "/material.html"
      },
      {
        "source": "/materials/order/**",
        "destination": "/order.html"
      },
      {
        "source": "/materials/**",
        "destination": "/materials/_category.html"
      },
      {
        "source": "/[a-z0-9][a-z0-9][a-z0-9][a-z0-9][a-z0-9][a-z0-9]",
        "destination": "/go.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=(), payment=()"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains"
          }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|png|webp|svg)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=2592000"
          }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "/data/@(content-index|blog-index).json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=600"
          }
        ]
      },
      {
        "source": "/data/seed-db.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/admin/**",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          },
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "source": "/sponsor/**",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          },
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      }
    ]
  },
  "database": {
    "rules": "database.rules.json"
  }
}